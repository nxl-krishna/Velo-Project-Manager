DATABASE_URL="postgresql://postgres:postgres@localhost:5433/projecthub_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/projecthub_dev"
# Use rediss:// for TLS providers such as Upstash
REDIS_URL="redis://localhost:6379"

# JWT (access tokens last 15 min; refresh tokens are stored in the database and rotate)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# AI Service
AI_SERVICE_URL="http://localhost:8000"
GOOGLE_AI_API_KEY="AIza..."
GEMINI_MODEL="gemini-3.8-flash"

# RAG insights (requires: CREATE EXTENSION IF NOT EXISTS vector WITH SCHEMA public;)
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
RAG_EMBEDS_PER_RUN="60"        # max new embeddings per 1-minute sync run
# RAG_SYNC_DISABLED="true"     # turn off the background index sync

# Email (password reset). Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters (no spaces) into SMTP_PASS.
# Leave SMTP_PASS empty in development to print reset links to the server log instead.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS=""
EMAIL_FROM="you@gmail.com"

# App (used for links in emails in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
